{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuclear-api",
  "account_id": "2e328fde1db62ab22f16e8f464562d3c",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 4 * * *", "0 5 * * *"] },
  "vars": {
    // Browser origins allowed to call /v1/admin/* (comma-separated). Add the admin portal's real URL
    // (the hosted one is already listed). The operator token is still required on every call.
    // The address image keys are turned into full URLs on (unset = the address of the request).
    "PUBLIC_URL": "https://nuclear-api.a-space.workers.dev",
    // The merchant portal (local dev and hosted) may call the business API from the browser.
    "MERCHANT_ORIGINS": "http://localhost:5174,https://nuclear-merchant.a-space.workers.dev",
    // The organization portal (local dev and hosted).
    "ORG_ORIGINS": "http://localhost:5175,https://nuclear-organization.a-space.workers.dev",
    "ADMIN_ORIGINS": "http://localhost:5173,https://nuclear-admin.a-space.workers.dev",
    // EMAIL IS OFF (owner, 2026-10-22: a send failed and hurt the sender reputation). With no EMAIL_FROM nothing is sent and the text is kept in the
    // audit log. To turn it back on, restore: "EMAIL_FROM": "Nuclear <noreply@nclr.app>" (nclr.app must be a verified sending domain) and deploy.
    // Where emailed links (verify email, reset password) open for businesses and organizations.
    "MERCHANT_PORTAL_URL": "https://nuclear-merchant.a-space.workers.dev",
    "ORG_PORTAL_URL": "https://nuclear-organization.a-space.workers.dev",
    // Sandbox only. Remove (or set to "false") before any live-money deployment.
    "SANDBOX_FUNDING": "true"
  },
  // Uploaded images (tag and shop pictures). Created 2026-10-16: `wrangler r2 bucket create nuclear-images`.
  // Private uploads (business documents): `wrangler r2 bucket create nuclear-uploads`. Email: Cloudflare Email Service binding; set EMAIL_FROM once the sending domain is verified.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "nuclear-images" },
    { "binding": "UPLOADS", "bucket_name": "nuclear-uploads" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  // Today's running estimate for the admin Overview (display only; the nightly snapshot is exact). Counters live in RAM and are saved every few seconds.
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "StatsCounter" }, { "name": "LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsCounter"] }, { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }],
  // Resizes profile photos to 256 x 256 JPEG on upload.
  "images": { "binding": "IMG" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6e47c72ff9934571ab4d21c0f2c40621"
    }
  ]
}
