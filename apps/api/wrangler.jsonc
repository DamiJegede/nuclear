{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuclear-api",
  "account_id": "2e328fde1db62ab22f16e8f464562d3c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 4 * * *", "0 5 * * *"] },
  "vars": {
    // Browser origins allowed to call /v1/admin/* (comma-separated). Add the admin portal's real URL
    // (the hosted one is already listed). The operator token is still required on every call.
    "ADMIN_ORIGINS": "http://localhost:5173,https://nuclear-admin.a-space.workers.dev",
    // Sandbox only. Remove (or set to "false") before any live-money deployment.
    "SANDBOX_FUNDING": "true"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6e47c72ff9934571ab4d21c0f2c40621"
    }
  ]
}
