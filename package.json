{
  "name": "nuclear",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @nuclear/api",
    "api:deploy": "npm run deploy -w @nuclear/api",
    "mcp:dev": "npm run dev -w @nuclear/mcp",
    "mcp:deploy": "npm run deploy -w @nuclear/mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "add-model": "node scripts/add-model.mjs",
    "add-bands": "node scripts/add-bands.mjs",
    "admin:dev": "npm run dev -w @nuclear/admin-portal",
    "admin:build": "npm run build -w @nuclear/admin-portal",
    "admin:test": "npm run test -w @nuclear/admin-portal",
    "merchant:dev": "npm run dev -w @nuclear/merchant-portal",
    "merchant:build": "npm run build -w @nuclear/merchant-portal",
    "merchant:test": "npm run test -w @nuclear/merchant-portal",
    "org:dev": "npm run dev -w @nuclear/organization-portal",
    "org:build": "npm run build -w @nuclear/organization-portal",
    "org:test": "npm run test -w @nuclear/organization-portal",
    "add-admin": "node scripts/add-admin.mjs",
    "manage-admin": "node scripts/manage-admin.mjs",
    "test:api": "npm run test -w @nuclear/api --",
    "test:admin": "npm run test -w @nuclear/admin-portal"
  }
}
